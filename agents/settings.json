{
  "model": "opus[1m]",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/mempalace-mine.sh precompact",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git status > /tmp/claude-git-context.txt; echo 'Development context loaded'"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/michaelmead/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/mempalace-mine.sh stop",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/skill-simple-instruction-hook.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "mempalace@mempalace": true,
    "pyright-lsp@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "trading-skills@agiprolabs-claude-trading-skills": true,
    "typescript-lsp@claude-plugins-official": true,
    "northflank@northflank": true
  },
  "extraKnownMarketplaces": {
    "agiprolabs-claude-trading-skills": {
      "source": {
        "source": "github",
        "repo": "agiprolabs/claude-trading-skills"
      }
    },
    "marketingskills": {
      "source": {
        "source": "github",
        "repo": "coreyhaines31/marketingskills"
      }
    },
    "mempalace": {
      "source": {
        "source": "github",
        "repo": "MemPalace/mempalace"
      }
    },
    "northflank": {
      "source": {
        "source": "github",
        "repo": "northflank/skills"
      }
    }
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "editorMode": "vim",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
